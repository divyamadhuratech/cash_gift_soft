PORT=3005
NODE_ENV=development

# Required — Mongo connection string
MONGO_URI=mongodb://127.0.0.1:27017/muhurtham
# Required — at least 32 random chars (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Binary asset storage (logos, backgrounds). Only "local" is implemented.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_BYTES=5242880
JSON_BODY_LIMIT=8mb

# --- Google sign-in (optional; leave empty to hide the Google button) -------
# Create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI to register: http://localhost:3005/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback
FRONTEND_URL=http://localhost:5173
